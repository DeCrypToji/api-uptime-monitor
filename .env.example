# API Uptime Monitor — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# ============================================================================
# SERVER
# ============================================================================
PORT=8000
GIN_MODE=debug # debug, release

# ============================================================================
# DATABASE (PostgreSQL RDS)
# ============================================================================
DB_HOST=localhost # localhost for dev, RDS endpoint for prod
DB_PORT=5432
DB_USER=uptime_user
DB_PASSWORD=your_secure_password_here
DB_NAME=uptime_monitor

# ============================================================================
# JWT (Authentication)
# ============================================================================
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRATION_HOURS=24

# ============================================================================
# SLACK (For alerts)
# ============================================================================
# For MVP: users provide their own webhook URL (manual)
# For v1.1: implement OAuth with these
SLACK_CLIENT_ID=xoxp-your-slack-client-id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret

# ============================================================================
# AWS (For Lambda health checks, Secrets Manager, etc)
# ============================================================================
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ============================================================================
# STRIPE (For billing — v1.1)
# ============================================================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================================
# GitHub OAuth (Optional social login)
# ============================================================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:8000/api/v1/auth/github/callback

# ============================================================================
# MONITORING
# ============================================================================
ENVIRONMENT=development # development, staging, production
LOG_LEVEL=debug # debug, info, warn, error

# ============================================================================
# FRONTEND (For CORS)
# ============================================================================
FRONTEND_URL=http://localhost:3000 # React dev server
